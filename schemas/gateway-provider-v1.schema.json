{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway provider v1 messages",
  "description": "Structural validation only. Host activation remains unavailable until continuity and usage integration are complete. Message order, exact declaration equality, canonical numeric/base64 bytes, decoded state bounds and final output semantics require additional validation.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "sequence",
        "operation"
      ],
      "properties": {
        "protocol": {
          "const": "gateway-provider/v1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "sequence",
        "value"
      ],
      "properties": {
        "protocol": {
          "const": "gateway-provider/v1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "value": {
          "$ref": "#/$defs/result"
        }
      }
    }
  ],
  "$defs": {
    "opaque_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version",
        "data_base64"
      ],
      "properties": {
        "format": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "data_base64": {
          "type": "string",
          "maxLength": 1398104,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
        }
      }
    },
    "counter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "value"
          ],
          "properties": {
            "source": {
              "const": "reported"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "not_reported"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "not_applicable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "invalid"
            }
          }
        }
      ]
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "input_regular_tokens",
        "cache_read_input_tokens",
        "cache_write_input_tokens",
        "reasoning_output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "$ref": "#/$defs/counter"
        },
        "output_tokens": {
          "$ref": "#/$defs/counter"
        },
        "total_tokens": {
          "$ref": "#/$defs/counter"
        },
        "input_regular_tokens": {
          "$ref": "#/$defs/counter"
        },
        "cache_read_input_tokens": {
          "$ref": "#/$defs/counter"
        },
        "cache_write_input_tokens": {
          "$ref": "#/$defs/counter"
        },
        "reasoning_output_tokens": {
          "$ref": "#/$defs/counter"
        }
      }
    },
    "usage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unobserved"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "counters"
          ],
          "properties": {
            "kind": {
              "const": "observed"
            },
            "counters": {
              "$ref": "#/$defs/counters"
            }
          }
        }
      ]
    },
    "state_result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "opaque"
            },
            "value": {
              "$ref": "#/$defs/opaque_state"
            }
          }
        }
      ]
    },
    "continuation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "stateless"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "pending_tools",
            "history"
          ],
          "properties": {
            "mode": {
              "const": "managed"
            },
            "pending_tools": {
              "type": "boolean"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end",
                  "state"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "state": {
                    "$ref": "#/$defs/opaque_state"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "editing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "policy"
          ],
          "properties": {
            "kind": {
              "const": "enabled"
            },
            "policy": {
              "$ref": "gateway-api-codec-v3.schema.json#/$defs/editing"
            }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_protocol",
        "model",
        "profile_id",
        "profile_version",
        "support",
        "editing"
      ],
      "properties": {
        "provider_protocol": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}/v[1-9][0-9]{0,5}(?![\\s\\S])"
        },
        "model": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "support": {
          "$ref": "gateway-api-codec-v3.schema.json#/$defs/route/properties/support"
        },
        "editing": {
          "$ref": "#/$defs/editing"
        }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "route",
        "continuation",
        "max_request_bytes",
        "max_output_bytes"
      ],
      "properties": {
        "request": {
          "type": "object"
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "continuation": {
          "$ref": "#/$defs/continuation"
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "value"
          ],
          "properties": {
            "operation": {
              "const": "prepare"
            },
            "value": {
              "$ref": "#/$defs/prepare"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "body",
            "response_id"
          ],
          "properties": {
            "operation": {
              "const": "json"
            },
            "body": {
              "type": "string"
            },
            "response_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "response_id"
          ],
          "properties": {
            "operation": {
              "const": "stream"
            },
            "response_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "event",
            "data"
          ],
          "properties": {
            "operation": {
              "const": "event"
            },
            "event": {
              "type": "string"
            },
            "data": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "finish"
            }
          }
        }
      ]
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response",
        "outcome",
        "usage",
        "state"
      ],
      "properties": {
        "response": {
          "type": "object"
        },
        "outcome": {
          "enum": [
            "completed",
            "awaiting_tools",
            "incomplete"
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "state": {
          "$ref": "#/$defs/state_result"
        }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "provider_protocol",
            "capabilities"
          ],
          "properties": {
            "result": {
              "const": "ready"
            },
            "provider_protocol": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,63}/v[1-9][0-9]{0,5}(?![\\s\\S])"
            },
            "capabilities": {
              "$ref": "gateway-extension-package-v2.schema.json#/$defs/provider_capabilities"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "payload"
          ],
          "properties": {
            "result": {
              "const": "prepared"
            },
            "payload": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "events",
            "complete",
            "usage"
          ],
          "properties": {
            "result": {
              "const": "progress"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "complete": {
              "type": "boolean"
            },
            "usage": {
              "$ref": "#/$defs/usage"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "value"
          ],
          "properties": {
            "result": {
              "const": "completed"
            },
            "value": {
              "$ref": "#/$defs/completed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "code"
          ],
          "properties": {
            "result": {
              "const": "rejected"
            },
            "code": {
              "enum": [
                "unsupported_request",
                "invalid_upstream",
                "unsupported_state",
                "resource_limit"
              ]
            }
          }
        }
      ]
    }
  }
}
